# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# 本地测试语料，不入库（有版权）
/book/

# 临时探针
_probe.txt
_t.ts

# 会话产物
.claude/scheduled_tasks.lock

# 环境变量模板要入库
!.env.local.example
